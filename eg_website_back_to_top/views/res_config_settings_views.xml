<odoo>
    <record id="website_back_to_top_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">website.back.to.top.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="eg_app_base.eg_app_base_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='eg_app_base']" position="after">
                <block title="Website Back to Top" id="website_back_to_top">
                    <setting id="website_back_to_top_setting" help="eg_website_back_to_top">
                        <field name="enable_eg_website_back_to_top"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
